# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Committed template (no secrets). Must come after the .env* rule above.
!.env.example

# Defensive: catches a credentials file saved without the leading dot.
env.local
env*.local

# Supabase CLI scratch state (project ref, linked-project metadata).
supabase/.temp/

# Reference PDFs kept beside the project but not published.
Documentation.pdf
Study.pdf
